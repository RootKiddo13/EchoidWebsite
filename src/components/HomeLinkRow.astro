---
import type { EchoidSiteData } from "../data/site";

type HomeLink = EchoidSiteData["links"][number];

type Props = {
  link: HomeLink;
};

const { link } = Astro.props;
---
<a
  class="home-link-row"
  href={link.href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${link.accessibleName}: ${link.keywords.split(" · ").join(", ")}`}
>
  <span class="home-link-copy">
    <span class="home-link-label">{link.label}</span>
    <span class="home-link-keywords">{link.keywords}</span>
  </span>
  <svg class="home-link-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M7 17 17 7M8 7h9v9" />
  </svg>
</a>
