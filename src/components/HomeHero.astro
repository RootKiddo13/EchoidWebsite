---
import { siteData } from "../data/site";
import HomeContactRow from "./HomeContactRow.astro";
import HomeLinkRow from "./HomeLinkRow.astro";
import AboutModal from "./AboutModal.astro";
import SiteHeader from "./SiteHeader.astro";

const tagline = siteData.home.tagline;
const lineBreakAfter = siteData.home.taglineLineBreakAfter;
const lineBreakEnd = tagline.indexOf(lineBreakAfter) + lineBreakAfter.length;
const emphasisStart = tagline.indexOf(siteData.home.taglineEmphasis, lineBreakEnd);
const hasTaglineTreatment = lineBreakEnd > lineBreakAfter.length && emphasisStart >= lineBreakEnd;
const taglineFirstLine = hasTaglineTreatment ? tagline.slice(0, lineBreakEnd) : tagline;
const taglineBeforeEmphasis = hasTaglineTreatment
  ? tagline.slice(lineBreakEnd, emphasisStart).trim()
  : "";
const taglineAfterEmphasis = hasTaglineTreatment
  ? tagline.slice(emphasisStart + siteData.home.taglineEmphasis.length).trim()
  : "";
---
<main class="home-page">
  <a class="skip-link" href="#home-content">Ana içeriğe geç</a>
  <section class="hero" aria-labelledby="home-title">
    <img
      class="hero-art"
      src="/assets/brand/echoid-website-hero-selected-v1.png"
      alt=""
      aria-hidden="true"
      width="1672"
      height="941"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-overlay" aria-hidden="true"></div>

    <SiteHeader />
    <AboutModal />

    <div class="hero-content" id="home-content" tabindex="-1">
      <p class="hero-kicker"><span aria-hidden="true"></span>{siteData.home.kicker}</p>
      <h1 id="home-title" aria-label={tagline}>
        {hasTaglineTreatment ? (
          <>
            <span>{taglineFirstLine}</span>
            <br />
            <span>{taglineBeforeEmphasis} </span>
            <span class="hero-title-accent">{siteData.home.taglineEmphasis}</span>
            <span> {taglineAfterEmphasis}</span>
          </>
        ) : (
          <span>{tagline}</span>
        )}
      </h1>
      <p class="hero-description">{siteData.home.description}</p>

      <nav class="home-links" aria-label="Echoid bağlantıları">
        {siteData.links.map((link) => <HomeLinkRow link={link} />)}
        <HomeContactRow email={siteData.contact.email} keywords={siteData.contact.keywords} />
      </nav>
    </div>

    <footer class="hero-footer">
      <span>{siteData.about.footer}</span>
    </footer>
  </section>
</main>
